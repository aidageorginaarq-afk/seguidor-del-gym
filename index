      function loadExerciseForEdit(exId) {
        const ex = state.catalog.find(c => c.id === exId);
        if (!ex) return;
        document.getElementById('catEditId').value = ex.id;
        document.getElementById('catalogFormTitle').textContent = `✏️ Editando: ${ex.name}`;
        document.getElementById('btnCatSubmit').textContent = 'Actualizar ejercicio';
        document.getElementById('btnCancelEditCat').classList.remove('hidden');
        document.getElementById('catName').value = ex.name;
        document.getElementById('catEveryday').value = ex.everyday || '';
        document.getElementById('catRoutine').value = ex.routine;
        document.getElementById('catTargetSets').value = ex.targetSets || 3;
        document.getElementById('catTargetReps').value = ex.targetReps || '10';
        document.getElementById('catLeverSeat').value = (ex.levers && ex.levers.seat) || '';
        document.getElementById('catLeverBack').value = (ex.levers && ex.levers.back) || '';
        document.getElementById('catLeverMid').value = (ex.levers && ex.levers.mid) || '';
        document.getElementById('catAssisted').checked = !!ex.isAssisted;
        selectedNewIcon = ex.icon || 'leg_press';
        renderIconPicker();
        window.scrollTo({ top: 0, behavior: 'smooth' });
