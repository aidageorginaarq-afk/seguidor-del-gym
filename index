<!DOCTYPE html>
<html lang="es" data-theme="lowlight">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Gym Tracker">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="theme-color" id="metaThemeColor" content="#12101a">
  <title>Gym Tracker — Tu Control de Entrenamiento</title>
  <style>
    /* =========================================================================
       VARIABLES DE TEMA (3 TEMAS: POCA LUZ / BEIGE ORGÁNICO / MAGENTA SUAVE)
       ========================================================================= */
    :root,
    [data-theme="lowlight"] {
      --bg-app: #12101a;
      --bg-surface: #1b1826;
      --bg-surface-2: #242033;
      --bg-input: #15121f;
      --border: #322c46;
      --text-main: #f4f2fa;
      --text-sub: #b3acc9;
      --text-muted: #7c7496;
      --accent: #b794f6;
      --accent-strong: #8b5cf6;
      --accent-2: #e879f9;
      --accent-soft: rgba(183, 148, 246, 0.15);
      --accent-glow: rgba(139, 92, 246, 0.3);
      --success: #34d399;
      --success-soft: rgba(52, 211, 153, 0.14);
      --warning: #fbbf24;
      --warning-soft: rgba(251, 191, 36, 0.15);
      --danger: #fb7185;
      --danger-soft: rgba(251, 113, 133, 0.15);
      --nav-bg: rgba(27, 24, 38, 0.96);
      --shadow: 0 8px 24px rgba(0, 0, 0, 0.38);
    }

    [data-theme="beige"] {
      --bg-app: #f5f0e8;
      --bg-surface: #fffdf9;
      --bg-surface-2: #efe7dc;
      --bg-input: #faf6f0;
      --border: #dfd3c3;
      --text-main: #2d251e;
      --text-sub: #66584b;
      --text-muted: #938374;
      --accent: #9a5b3c;
      --accent-strong: #84492d;
      --accent-2: #c9865b;
      --accent-soft: rgba(154, 91, 60, 0.11);
      --accent-glow: rgba(132, 73, 45, 0.22);
      --success: #2f7d57;
      --success-soft: rgba(47, 125, 87, 0.11);
      --warning: #b4690e;
      --warning-soft: rgba(180, 105, 14, 0.12);
      --danger: #c43c4e;
      --danger-soft: rgba(196, 60, 78, 0.11);
      --nav-bg: rgba(255, 253, 249, 0.96);
      --shadow: 0 6px 18px rgba(45, 37, 30, 0.08);
    }

    [data-theme="magenta"] {
      --bg-app: #1c101b;
      --bg-surface: #291728;
      --bg-surface-2: #361f35;
      --bg-input: #201220;
      --border: #4f2f4d;
      --text-main: #fdf4fc;
      --text-sub: #e0badd;
      --text-muted: #a97da6;
      --accent: #f472b6;
      --accent-strong: #db2777;
      --accent-2: #e879f9;
      --accent-soft: rgba(244, 114, 182, 0.16);
      --accent-glow: rgba(219, 39, 119, 0.32);
      --success: #4ade80;
      --success-soft: rgba(74, 222, 128, 0.14);
      --warning: #fcd34d;
      --warning-soft: rgba(252, 211, 77, 0.15);
      --danger: #fda4af;
      --danger-soft: rgba(253, 164, 175, 0.15);
      --nav-bg: rgba(41, 23, 40, 0.96);
      --shadow: 0 8px 24px rgba(14, 4, 13, 0.45);
    }

    /* =========================================================================
       BASE Y LAYOUT MOBILE-FIRST (CERO DESBORDAMIENTO HORIZONTAL)
       ========================================================================= */
    *, *::before, *::after {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-app);
      color: var(--text-main);
      line-height: 1.45;
      overflow-x: hidden;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    body {
      min-height: 100vh;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px));
    }

    .app-shell {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      padding: 12px 12px 24px;
    }

    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 15px;
      margin-bottom: 13px;
      box-shadow: var(--shadow);
    }

    .subcard {
      background: var(--bg-surface-2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
    }

    .hidden { display: none !important; }

    h1, h2, h3, p { margin: 0; }
    .title-lg { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.02em; }
    .title-md { font-size: 0.98rem; font-weight: 700; }
    .label-caps {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-sub);
    }
    .text-sub { color: var(--text-sub); font-size: 0.84rem; }
    .text-muted { color: var(--text-muted); font-size: 0.75rem; }
    .text-accent { color: var(--accent); }

    /* Flex y Grid */
    .row { display: flex; align-items: center; gap: 10px; }
    .row-between { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .row-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .stack { display: flex; flex-direction: column; gap: 10px; }
    .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    @media (min-width: 600px) {
      .app-shell { padding: 18px 20px 26px; }
      .grid-sm-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    }

    /* =========================================================================
       CONTROLES, BOTONES E INPUTS TÁCTILES (MÍNIMO 44PX)
       ========================================================================= */
    input, select, textarea, button {
      font-family: inherit;
      color: inherit;
    }

    .field-label {
      display: block;
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--text-sub);
      margin-bottom: 5px;
    }

    .input {
      width: 100%;
      min-height: 44px;
      padding: 9px 12px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-input);
      color: var(--text-main);
      font-size: 0.94rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 44px;
      padding: 10px 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-surface-2);
      color: var(--text-main);
      font-size: 0.87rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.12s ease, border-color 0.2s, background 0.2s;
      user-select: none;
    }

    .btn:active { transform: scale(0.97); }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent-strong), var(--accent-2));
      border-color: transparent;
      color: #ffffff;
      box-shadow: 0 6px 18px var(--accent-glow);
    }

    .btn-soft {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent);
    }

    .btn-success {
      background: var(--success-soft);
      border-color: var(--success);
      color: var(--success);
    }

    .btn-danger {
      background: var(--danger-soft);
      border-color: var(--danger);
      color: var(--danger);
    }

    .btn-sm { min-height: 38px; padding: 6px 11px; font-size: 0.78rem; border-radius: 10px; }
    .btn-icon { width: 38px; height: 38px; min-height: 38px; padding: 0; border-radius: 10px; }
    .btn-block { width: 100%; }

    .pill {
      min-height: 44px;
      padding: 8px 10px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-surface-2);
      color: var(--text-sub);
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: all 0.18s ease;
    }

    .pill.active {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Stepper táctil +/- */
    .stepper {
      display: flex;
      align-items: center;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      min-height: 46px;
    }

    .stepper-btn {
      width: 40px;
      height: 46px;
      border: none;
      background: var(--bg-surface-2);
      color: var(--text-main);
      font-size: 1.2rem;
      font-weight: 800;
      cursor: pointer;
      flex-shrink: 0;
    }

    .stepper-btn:active {
      background: var(--accent-soft);
      color: var(--accent);
    }

    .stepper-input {
      width: 100%;
      min-width: 0;
      border: none;
      background: transparent;
      color: var(--text-main);
      text-align: center;
      font-size: 1.02rem;
      font-weight: 800;
      outline: none;
      padding: 4px 2px;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 700;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: var(--text-sub);
    }
    .badge-accent { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
    .badge-warning { background: var(--warning-soft); border-color: var(--warning); color: var(--warning); }

    /* =========================================================================
       ÍCONOS DE MÁQUINAS, FICHA DE PALANCAS Y CHECKLIST
       ========================================================================= */
    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--accent-strong), var(--accent-2));
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 5px 14px var(--accent-glow);
    }

    .machine-svg-box {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .machine-svg-box.lg {
      width: 58px;
      height: 58px;
      border-radius: 15px;
      background: var(--accent-soft);
      border-color: var(--accent);
    }

    .everyday-pill {
      display: inline-block;
      margin-top: 4px;
      padding: 4px 9px;
      border-radius: 9px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 700;
      line-height: 1.3;
    }

    .lever-box {
      background: var(--bg-surface-2);
      border: 1px dashed var(--accent);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 13px;
    }

    .lever-input {
      width: 100%;
      min-height: 40px;
      padding: 6px 9px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--bg-input);
      color: var(--text-main);
      font-size: 0.86rem;
      font-weight: 700;
      outline: none;
    }
    .lever-input:focus { border-color: var(--accent); }

    .memory-box {
      background: linear-gradient(145deg, var(--accent-soft), var(--bg-surface-2));
      border: 1px solid var(--accent);
      border-radius: 16px;
      padding: 13px;
      margin-bottom: 13px;
    }

    .ex-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 315px;
      overflow-y: auto;
      padding-right: 2px;
    }

    .ex-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 10px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--bg-surface-2);
      cursor: pointer;
      transition: border-color 0.18s, background 0.18s;
    }

    .ex-item.selected {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .ex-item.done { border-color: var(--success); }

    .check-circle {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border: 2px solid var(--text-muted);
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      cursor: pointer;
      color: transparent;
    }

    .ex-item.done .check-circle {
      background: var(--success);
      border-color: var(--success);
      color: #0b1612;
    }

    .ex-meta { flex: 1; min-width: 0; }
    .ex-name {
      font-size: 0.89rem;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ex-everyday {
      font-size: 0.74rem;
      color: var(--text-sub);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ex-weight-line {
      font-size: 0.73rem;
      font-weight: 700;
      color: var(--accent);
      margin-top: 2px;
    }

    .progress-track {
      width: 100%;
      height: 9px;
      border-radius: 999px;
      background: var(--bg-surface-2);
      border: 1px solid var(--border);
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--accent-strong), var(--accent-2));
      transition: width 0.35s ease;
    }
    .progress-fill-success { background: linear-gradient(90deg, var(--success), var(--accent)); }

    .icon-picker {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(48px, 1fr));
      gap: 6px;
    }
    .icon-opt {
      height: 46px;
      border-radius: 11px;
      border: 1px solid var(--border);
      background: var(--bg-input);
      color: var(--text-sub);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .icon-opt.active {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--accent);
    }

    /* =========================================================================
       CRONÓMETRO FLOTANTE Y BARRA INFERIOR DE 5 PESTAÑAS
       ========================================================================= */
    .timer-fab {
      position: fixed;
      right: 14px;
      bottom: calc(82px + env(safe-area-inset-bottom, 0px));
      z-index: 45;
      min-height: 46px;
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--accent);
      background: var(--bg-surface);
      color: var(--text-main);
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.42);
      display: flex;
      align-items: center;
      gap: 7px;
      font-weight: 800;
      font-size: 0.86rem;
      cursor: pointer;
    }

    .timer-fab.running {
      background: linear-gradient(135deg, var(--accent-strong), var(--accent-2));
      color: #ffffff;
      border-color: transparent;
    }

    .timer-panel {
      position: fixed;
      right: 14px;
      bottom: calc(136px + env(safe-area-inset-bottom, 0px));
      z-index: 46;
      width: min(305px, calc(100vw - 28px));
      background: var(--bg-surface);
      border: 1px solid var(--accent);
      border-radius: 18px;
      padding: 14px;
      box-shadow: 0 14px 36px rgba(0, 0, 0, 0.5);
    }

    .timer-digits {
      font-size: 2.25rem;
      font-weight: 800;
      text-align: center;
      font-variant-numeric: tabular-nums;
      color: var(--accent);
      margin: 6px 0 10px;
    }

    .bottom-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      background: var(--nav-bg);
      border-top: 1px solid var(--border);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .bottom-nav-inner {
      max-width: 760px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      padding: 5px 2px 7px;
    }

    .nav-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      min-height: 50px;
      padding: 4px 2px;
      font-size: 0.67rem;
      font-weight: 600;
      cursor: pointer;
    }

    .nav-btn.active { color: var(--accent); font-weight: 800; }

    .nav-bar-ind {
      width: 24px;
      height: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      opacity: 0;
      transform: scaleX(0);
      transition: all 0.2s ease;
    }
    .nav-btn.active .nav-bar-ind { opacity: 1; transform: scaleX(1); }

    /* =========================================================================
       GRÁFICA SVG, STATS, INSTALL CARD, TOAST Y MODAL
       ========================================================================= */
    .svg-chart-wrap {
      width: 100%;
      overflow: hidden;
      border-radius: 14px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      padding: 10px 6px 6px;
    }

    .stat-box {
      background: var(--bg-surface-2);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 10px 8px;
      text-align: center;
    }
    .stat-val { font-size: 1.12rem; font-weight: 800; color: var(--accent); margin-top: 2px; }

    .unit-switch {
      display: inline-flex;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 3px;
      gap: 3px;
    }
    .unit-switch button {
      border: none;
      background: transparent;
      color: var(--text-sub);
      font-size: 0.78rem;
      font-weight: 800;
      padding: 6px 12px;
      border-radius: 8px;
      cursor: pointer;
    }
    .unit-switch button.active {
      background: var(--accent);
      color: #ffffff;
    }

    .app-preview-icon {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      border: 1px solid var(--border);
      box-shadow: 0 6px 16px var(--accent-glow);
      flex-shrink: 0;
    }

    .toast-wrap {
      position: fixed;
      top: calc(14px + env(safe-area-inset-top, 0px));
      left: 50%;
      transform: translateX(-50%);
      z-index: 60;
      width: min(420px, calc(100vw - 24px));
      display: flex;
      flex-direction: column;
      gap: 8px;
      pointer-events: none;
    }

    .toast {
      pointer-events: auto;
      background: var(--bg-surface);
      border: 1px solid var(--accent);
      color: var(--text-main);
      padding: 11px 14px;
      border-radius: 13px;
      font-size: 0.84rem;
      font-weight: 700;
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.42);
      display: flex;
      align-items: center;
      gap: 9px;
      animation: slideDown 0.2s ease-out;
    }
    .toast.danger { border-color: var(--danger); }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 70;
      background: rgba(0, 0, 0, 0.65);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal-card {
      width: 100%;
      max-width: 360px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    }
  </style>
</head>
<body>
  <div class="app-shell">

    <!-- =======================================================================
         ENCABEZADO GLOBAL
         ======================================================================= -->
    <header class="card">
      <div class="row-between" style="flex-wrap: wrap;">
        <div class="row">
          <div class="brand-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"/>
            </svg>
          </div>
          <div>
            <h1 class="title-lg">Gym Tracker</h1>
            <p class="text-muted" id="headerDate">Hoy</p>
          </div>
        </div>

        <div style="min-width: 155px;">
          <label for="themeSelect" class="hidden">Tema visual</label>
          <select id="themeSelect" class="input" style="min-height: 40px; padding: 6px 10px; font-size: 0.82rem; font-weight: 700;">
            <option value="lowlight">🌙 Poca Luz</option>
            <option value="beige">☕ Beige Orgánico</option>
            <option value="magenta">🌸 Magenta Suave</option>
          </select>
        </div>
      </div>
    </header>

    <!-- =======================================================================
         PESTAÑA 1: RUTINA
         ======================================================================= -->
    <main id="tab-rutina" class="tab-panel">

      <!-- Selector de Rutina + Checklist Visual -->
      <section class="card">
        <div class="row-between" style="margin-bottom: 10px;">
          <span class="label-caps">1. Elige tu rutina</span>
          <span id="routineProgressBadge" class="badge badge-accent">0 / 0 hechos</span>
        </div>

        <div class="grid-2" id="routinePills" style="margin-bottom: 10px;">
