          // Fondo degradado violeta oscuro -> magenta
          const grad = ctx.createLinearGradient(0, 0, 512, 512);
          grad.addColorStop(0, '#12101a');
          grad.addColorStop(0.55, '#4c1d95');
          grad.addColorStop(1, '#c026d3');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, 512, 512);

          // Brillo radial sutil al centro
          const glow = ctx.createRadialGradient(256, 220, 20, 256, 256, 240);
          glow.addColorStop(0, 'rgba(244, 114, 182, 0.30)');
          glow.addColorStop(1, 'rgba(18, 16, 26, 0)');
          ctx.fillStyle = glow;
          ctx.fillRect(0, 0, 512, 512);

          // Helper de rectángulo redondeado
          function roundRect(x, y, w, h, r) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.arcTo(x + w, y, x + w, y + h, r);
            ctx.arcTo(x + w, y + h, x, y + h, r);
            ctx.arcTo(x, y + h, x, y, r);
            ctx.arcTo(x, y, x + w, y, r);
            ctx.closePath();
            ctx.fill();
          }

          // Mancuerna minimalista blanca ligeramente inclinada
          ctx.save();
          ctx.translate(256, 262);
          ctx.rotate(-Math.PI / 8);
          ctx.fillStyle = '#ffffff';
          ctx.shadowColor = 'rgba(0, 0, 0, 0.35)';
          ctx.shadowBlur = 18;

          // Barra central
          roundRect(-95, -14, 190, 28, 14);
          // Discos internos
          roundRect(-126, -68, 36, 136, 16);
          roundRect(90, -68, 36, 136, 16);
          // Discos externos
          roundRect(-162, -46, 28, 92, 13);
          roundRect(134, -46, 28, 92, 13);
          ctx.restore();

          // Destello sutil superior derecho
          ctx.save();
          ctx.translate(382, 126);
          ctx.fillStyle = '#fde68a';
          ctx.beginPath();
          ctx.moveTo(0, -34);
          ctx.quadraticCurveTo(4, -4, 34, 0);
          ctx.quadraticCurveTo(4, 4, 0, 34);
          ctx.quadraticCurveTo(-4, 4, -34, 0);
          ctx.quadraticCurveTo(-4, -4, 0, -34);
          ctx.closePath();
          ctx.fill();
          ctx.restore();

          const pngDataUrl = canvas.toDataURL('image/png');

          // Inyectar apple-touch-icon y favicon
          const appleLink = document.createElement('link');
          appleLink.rel = 'apple-touch-icon';
          appleLink.href = pngDataUrl;
          document.head.appendChild(appleLink);

          const iconLink = document.createElement('link');
          iconLink.rel = 'icon';
          iconLink.type = 'image/png';
          iconLink.href = pngDataUrl;
          document.head.appendChild(iconLink);

          // Inyectar manifest dinámico como Blob
          const manifestObj = {
            name: 'Gym Tracker',
            short_name: 'Gym Tracker',
            display: 'standalone',
            background_color: '#12101a',
            theme_color: '#12101a',
            icons: [
              { src: pngDataUrl, sizes: '512x512', type: 'image/png', purpose: 'any maskable' }
            ]
          };
          const manifestBlob = new Blob([JSON.stringify(manifestObj)], { type: 'application/manifest+json' });
          const manifestUrl = URL.createObjectURL(manifestBlob);
          const manifestLink = document.createElement('link');
          manifestLink.rel = 'manifest';
          manifestLink.href = manifestUrl;
          document.head.appendChild(manifestLink);

          // Vista previa del ícono en la pestaña Respaldo
          const previewImg = document.getElementById('appIconPreview');
          if (previewImg) previewImg.src = pngDataUrl;
        } catch (err) {
          console.error('Error generando ícono PWA:', err);
        }
