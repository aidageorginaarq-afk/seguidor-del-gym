      function renderCatalogTab() {
        renderIconPicker();

        document.querySelectorAll('#catalogFilterBtns [data-catgroup]').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.catgroup === catalogFilterGroup);
        });

        const list = document.getElementById('catalogList');
        const items = state.catalog.filter(c => c.routine === catalogFilterGroup);
        if (!items.length) {
          list.innerHTML = '<p class="text-muted">Sin ejercicios en esta rutina.</p>';
          return;
        }

        list.innerHTML = items.map((ex, idx) => {
          const lv = ex.levers || {};
          const lvParts = [];
          if (lv.seat) lvParts.push(`Asiento: ${lv.seat}`);
          if (lv.back) lvParts.push(`Atrás: ${lv.back}`);
          if (lv.mid) lvParts.push(`Interm.: ${lv.mid}`);
          return `
            <div class="subcard row" style="gap: 10px;">
              <div class="machine-svg-box">${getIconSvg(ex.icon)}</div>
              <div style="flex: 1; min-width: 0;">
                <div class="row-wrap" style="gap: 5px;">
                  <strong style="font-size: 0.87rem;">${esc(ex.name)}</strong>
                  ${ex.isAssisted ? '<span class="badge badge-warning">Asistido</span>' : ''}
                </div>
                <p class="text-sub" style="font-size: 0.75rem;">${esc(ex.everyday)}</p>
                <p class="text-muted" style="margin-top: 2px;">
                  Meta: ${ex.targetSets}×${esc(ex.targetReps)}${lvParts.length ? ` · ⚙️ ${esc(lvParts.join(' | '))}` : ''}
                </p>
              </div>
              <div class="row" style="gap: 4px; flex-shrink: 0;">
                <button type="button" class="btn btn-icon btn-sm" data-edit="${esc(ex.id)}" aria-label="Editar">✏️</button>
                <button type="button" class="btn btn-icon btn-sm" data-up="${esc(ex.id)}" ${idx === 0 ? 'disabled style="opacity:0.35"' : ''} aria-label="Subir">↑</button>
                <button type="button" class="btn btn-icon btn-sm" data-down="${esc(ex.id)}" ${idx === items.length - 1 ? 'disabled style="opacity:0.35"' : ''} aria-label="Bajar">↓</button>
                <button type="button" class="btn btn-icon btn-sm" data-del="${esc(ex.id)}" aria-label="Eliminar">🗑</button>
              </div>
            </div>
          `;
        }).join('');

        list.querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => loadExerciseForEdit(b.dataset.edit)));
        list.querySelectorAll('[data-up]').forEach(b => b.addEventListener('click', () => moveCatalogExercise(b.dataset.up, -1)));
        list.querySelectorAll('[data-down]').forEach(b => b.addEventListener('click', () => moveCatalogExercise(b.dataset.down, 1)));
        list.querySelectorAll('[data-del]').forEach(b => {
          b.addEventListener('click', () => {
            const ex = state.catalog.find(c => c.id === b.dataset.del);
            openConfirm('Quitar del catálogo', `¿Eliminar "${ex ? ex.name : 'este ejercicio'}"? Tu historial previo se conserva.`, () => {
              state.catalog = state.catalog.filter(c => c.id !== b.dataset.del);
              saveState();
              renderCatalogTab();
              showToast('Ejercicio eliminado.');
            }, 'Eliminar');
          });
        });
      }

      function moveCatalogExercise(exId, dir) {
        const indices = [];
        state.catalog.forEach((c, i) => { if (c.routine === catalogFilterGroup) indices.push(i); });
        const pos = indices.findIndex(i => state.catalog[i].id === exId);
        const swap = pos + dir;
        if (pos < 0 || swap < 0 || swap >= indices.length) return;
        const a = indices[pos], b = indices[swap];
        const tmp = state.catalog[a];
        state.catalog[a] = state.catalog[b];
        state.catalog[b] = tmp;
        saveState();
        renderCatalogTab();
      }

      function handleCatalogSave(e) {
        e.preventDefault();
        const editId = document.getElementById('catEditId').value.trim();
        const name = document.getElementById('catName').value.trim();
        const everyday = document.getElementById('catEveryday').value.trim();
        const routine = document.getElementById('catRoutine').value;
        const targetSets = parseInt(document.getElementById('catTargetSets').value, 10) || 3;
        const targetReps = document.getElementById('catTargetReps').value.trim() || '10';
        const isAssisted = document.getElementById('catAssisted').checked;
        const levers = {
          seat: document.getElementById('catLeverSeat').value.trim(),
          back: document.getElementById('catLeverBack').value.trim(),
          mid: document.getElementById('catLeverMid').value.trim()
        };

        if (!name || !everyday) return;

        if (editId) {
          const ex = state.catalog.find(c => c.id === editId);
          if (ex) {
            ex.name = name;
            ex.everyday = everyday;
            ex.routine = routine;
            ex.icon = selectedNewIcon;
            ex.targetSets = targetSets;
            ex.targetReps = targetReps;
            ex.isAssisted = isAssisted;
            ex.levers = levers;
          }
          showToast(`"${name}" actualizado.`);
        } else {
          state.catalog.push({
            id: uid('ex'),
            name,
            everyday,
            routine,
            icon: selectedNewIcon,
            targetSets,
            targetReps,
            isAssisted,
            levers,
            defaultNote: ''
          });
          showToast(`"${name}" agregado a ${routine}.`);
        }

        saveState();
        catalogFilterGroup = routine;
        resetCatalogForm();
        renderCatalogTab();
      }

      /* -----------------------------------------------------------------------
         PESTAÑA 5: RESPALDO JSON
         ----------------------------------------------------------------------- */
      function renderBackupTab() {
        document.getElementById('bkStrength').textContent = state.strengthLogs.length;
        document.getElementById('bkCardio').textContent = state.cardioLogs.length;
        document.getElementById('bkCatalog').textContent = state.catalog.length;
      }

      function getBackupString() {
        return JSON.stringify({ app: 'Gym Tracker', version: 4, exportedAt: new Date().toISOString(), data: state }, null, 2);
      }

      function exportJson() {
        try {
          const blob = new Blob([getBackupString()], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `gym-tracker-respaldo-${getTodayISO()}.json`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
          showToast('Respaldo .json descargado.');
        } catch {
          showToast('Error al exportar.', 'danger');
        }
      }

      function importJsonFile(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          try {
            const parsed = JSON.parse(ev.target.result);
            const inc = parsed.data ? parsed.data : parsed;
            if (!inc || !Array.isArray(inc.catalog) || !Array.isArray(inc.strengthLogs)) {
              showToast('Archivo JSON no válido.', 'danger');
              return;
            }
            openConfirm('Importar respaldo', `Se restaurarán ${inc.strengthLogs.length} registros de fuerza y ${(inc.cardioLogs || []).length} de cardio.`, () => {
              state = {
                theme: inc.theme || 'lowlight',
                chartUnit: inc.chartUnit === 'kg' ? 'kg' : 'lb',
                catalog: inc.catalog,
                strengthLogs: inc.strengthLogs,
                cardioLogs: Array.isArray(inc.cardioLogs) ? inc.cardioLogs : [],
                completedByDate: inc.completedByDate || {}
              };
              saveState();
              applyTheme(state.theme);
              renderBackupTab();
              renderTrainTab();
              showToast('¡Respaldo restaurado!');
            }, 'Importar');
          } catch {
            showToast('No se pudo leer el archivo.', 'danger');
          } finally {
            e.target.value = '';
          }
        };
        reader.readAsText(file);
      }

      function resetDefaults() {
        openConfirm('Restaurar rutina base', 'Se recargarán tus rutinas, palancas y pesos iniciales. ¿Continuar?', () => {
          state = createDefaultData();
          saveState();
          applyTheme(state.theme);
          activeRoutine = 'Tren Inferior';
          selectedExerciseId = state.catalog[0].id;
          renderBackupTab();
          renderTrainTab();
          fillFormDefaultsForSelected(false);
          showToast('Rutina base restaurada.');
        }, 'Restaurar');
      }

      /* -----------------------------------------------------------------------
         CRONÓMETRO FLOTANTE (WEB AUDIO API)
         ----------------------------------------------------------------------- */
      function formatTimer(sec) {
        return `${String(Math.floor(sec / 60)).padStart(2, '0')}:${String(sec % 60).padStart(2, '0')}`;
      }

      function playSoftBeep() {
        try {
          const Ctx = window.AudioContext || window.webkitAudioContext;
          if (!Ctx) return;
          const ctx = new Ctx();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(680, ctx.currentTime);
          gain.gain.setValueAtTime(0.14, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.45);
        } catch {}
      }

      function updateTimerUI() {
        const txt = formatTimer(timerRemainingSec);
        document.getElementById('timerDisplay').textContent = txt;
        document.getElementById('timerFab').classList.toggle('running', timerRunning);
        document.getElementById('timerFabLabel').textContent = timerRunning ? txt : 'Descanso';
        document.getElementById('btnTimerToggle').textContent = timerRunning ? 'Pausar' : 'Iniciar';
      }

      function startTimer() {
        if (timerRemainingSec <= 0) timerRemainingSec = timerTotalSec;
        timerRunning = true;
        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
          timerRemainingSec--;
          if (timerRemainingSec <= 0) {
            timerRemainingSec = 0;
            pauseTimer();
            playSoftBeep();
            showToast('⏰ ¡Descanso terminado! Lista para tu siguiente serie.');
          }
          updateTimerUI();
        }, 1000);
        updateTimerUI();
      }

      function pauseTimer() {
        timerRunning = false;
        clearInterval(timerInterval);
        updateTimerUI();
      }

      /* -----------------------------------------------------------------------
         INICIALIZACIÓN
         ----------------------------------------------------------------------- */
      function init() {
        initPwaIconAndManifest();
        loadState();

        document.getElementById('headerDate').textContent = new Date().toLocaleDateString('es-MX', {
          weekday: 'long', day: 'numeric', month: 'long'
        });
        const today = getTodayISO();
        document.getElementById('inpDate').value = today;
        document.getElementById('cardioDate').value = today;

        applyTheme(state.theme);

        // Encabezado y navegación
        document.getElementById('themeSelect').addEventListener('change', e => applyTheme(e.target.value));
        document.querySelectorAll('.nav-btn').forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));

        // Pestaña Rutina
        document.querySelectorAll('#routinePills .pill').forEach(pill => {
          pill.addEventListener('click', () => {
            activeRoutine = pill.dataset.routine;
            document.querySelectorAll('#routinePills .pill').forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            renderTrainTab();
            fillFormDefaultsForSelected(false);
          });
        });

        ['leverSeat', 'leverBack', 'leverMid'].forEach(id => {
          document.getElementById(id).addEventListener('input', handleLeverAutoSave);
        });

        document.getElementById('inpWeightLb').addEventListener('input', syncFromLb);
        document.getElementById('inpWeightKg').addEventListener('input', syncFromKg);

        document.querySelectorAll('.stepper-btn').forEach(btn => {
          btn.addEventListener('click', () => handleStepper(btn.dataset.step, parseInt(btn.dataset.dir, 10)));
        });

        document.getElementById('btnUseLastData').addEventListener('click', () => fillFormDefaultsForSelected(true));
        document.getElementById('strengthForm').addEventListener('submit', handleStrengthSubmit);

        // Pestaña Cardio
        document.getElementById('cardioModality').addEventListener('change', toggleCardioFields);
        document.getElementById('cardioForm').addEventListener('submit', handleCardioSubmit);

        // Pestaña Gráficas y Compartir
        document.getElementById('chartExerciseSelect').addEventListener('change', renderChartsTab);
        document.getElementById('btnChartLb').addEventListener('click', () => {
          state.chartUnit = 'lb';
          saveState();
          renderChartsTab();
        });
        document.getElementById('btnChartKg').addEventListener('click', () => {
          state.chartUnit = 'kg';
          saveState();
          renderChartsTab();
        });
        document.getElementById('btnDownloadChartPng').addEventListener('click', downloadChartPng);
        document.getElementById('btnCopyWaChart').addEventListener('click', copyWhatsAppChartSummary);

        // Pestaña Catálogo
        document.getElementById('catalogForm').addEventListener('submit', handleCatalogSave);
        document.getElementById('btnCancelEditCat').addEventListener('click', resetCatalogForm);
        document.querySelectorAll('#catalogFilterBtns [data-catgroup]').forEach(btn => {
          btn.addEventListener('click', () => {
            catalogFilterGroup = btn.dataset.catgroup;
            renderCatalogTab();
          });
        });

        // Pestaña Respaldo
        document.getElementById('btnCopyWaBackup').addEventListener('click', copyWhatsAppFullSessionSummary);
        document.getElementById('btnExportJson').addEventListener('click', exportJson);
        document.getElementById('btnCopyJson').addEventListener('click', () => copyTextReliable(getBackupString(), 'JSON copiado al portapapeles.'));
        document.getElementById('btnImportJson').addEventListener('click', () => document.getElementById('importFileInput').click());
        document.getElementById('importFileInput').addEventListener('change', importJsonFile);
        document.getElementById('btnResetDefaults').addEventListener('click', resetDefaults);

        // Cronómetro
        const timerPanel = document.getElementById('timerPanel');
        document.getElementById('timerFab').addEventListener('click', () => timerPanel.classList.toggle('hidden'));
        document.getElementById('btnCloseTimer').addEventListener('click', () => timerPanel.classList.add('hidden'));
        document.querySelectorAll('.timer-preset').forEach(b => {
          b.addEventListener('click', () => {
            timerTotalSec = parseInt(b.dataset.sec, 10);
            timerRemainingSec = timerTotalSec;
            startTimer();
          });
        });
        document.getElementById('btnTimerToggle').addEventListener('click', () => (timerRunning ? pauseTimer() : startTimer()));
        document.getElementById('btnTimerReset').addEventListener('click', () => {
          pauseTimer();
          timerRemainingSec = timerTotalSec;
          updateTimerUI();
        });
        updateTimerUI();

        // Modal
        document.getElementById('modalCancel').addEventListener('click', closeConfirm);
        document.getElementById('modalOk').addEventListener('click', () => {
          if (typeof confirmCallback === 'function') confirmCallback();
          closeConfirm();
        });

        // Render inicial
        renderTrainTab();
        fillFormDefaultsForSelected(false);
      }

      document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</body>
</html>
