      function resetCatalogForm() {
        document.getElementById('catEditId').value = '';
        document.getElementById('catalogFormTitle').textContent = '+ Agregar ejercicio';
        document.getElementById('btnCatSubmit').textContent = 'Guardar en catálogo';
        document.getElementById('btnCancelEditCat').classList.add('hidden');
        document.getElementById('catName').value = '';
        document.getElementById('catEveryday').value = '';
        document.getElementById('catTargetSets').value = '3';
        document.getElementById('catTargetReps').value = '10';
        document.getElementById('catLeverSeat').value = '';
