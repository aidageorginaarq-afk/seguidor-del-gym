        try {
          const [y, m, d] = iso.split('-').map(Number);
          return new Date(y, m - 1, d).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' });
        } catch {
          return iso;
        }
      }

      function formatDateShort(iso) {
        if (!iso) return '';
        try {
          const [y, m, d] = iso.split('-').map(Number);
          return new Date(y, m - 1, d).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' });
        } catch {
          return iso;
        }
      }

      function copyTextReliable(text, successMsg) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '-9999px';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          ta.setSelectionRange(0, text.length);
          const ok = document.execCommand('copy');
          ta.remove();
          if (ok) {
            showToast(successMsg);
            return;
          }
        } catch {}
        showToast('No se pudo copiar automáticamente.', 'danger');
      }

      function loadState() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) {
            saveState();
            return;
          }
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.catalog) && parsed.catalog.length > 0) {
            state = {
              theme: parsed.theme || 'lowlight',
              chartUnit: parsed.chartUnit === 'kg' ? 'kg' : 'lb',
              catalog: parsed.catalog,
              strengthLogs: Array.isArray(parsed.strengthLogs) ? parsed.strengthLogs : [],
              cardioLogs: Array.isArray(parsed.cardioLogs) ? parsed.cardioLogs : [],
              completedByDate: parsed.completedByDate && typeof parsed.completedByDate === 'object' ? parsed.completedByDate : {}
            };
          }
        } catch (err) {
          console.error('Error leyendo localStorage:', err);
        }
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (err) {
          console.error('Error guardando localStorage:', err);
          showToast('No se pudo guardar en memoria local.', 'danger');
        }
      }

      /* -----------------------------------------------------------------------
         TOAST Y MODAL
         ----------------------------------------------------------------------- */
      function showToast(msg, type = 'ok') {
        const wrap = document.getElementById('toastWrap');
        const el = document.createElement('div');
        el.className = `toast ${type === 'danger' ? 'danger' : ''}`;
        el.innerHTML = `
          <span style="width:9px;height:9px;border-radius:99px;flex-shrink:0;background:${type === 'danger' ? 'var(--danger)' : 'var(--success)'};"></span>
          <span>${esc(msg)}</span>
        `;
        wrap.appendChild(el);
        setTimeout(() => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(-6px)';
          el.style.transition = 'all 0.25s ease';
          setTimeout(() => el.remove(), 260);
        }, 2600);
      }

      function openConfirm(title, message, onOk, okText = 'Confirmar') {
        document.getElementById('modalTitle').textContent = title;
        document.getElementById('modalMsg').textContent = message;
        document.getElementById('modalOk').textContent = okText;
        confirmCallback = onOk;
        document.getElementById('confirmModal').classList.remove('hidden');
      }

      function closeConfirm() {
        document.getElementById('confirmModal').classList.add('hidden');
        confirmCallback = null;
      }

      /* -----------------------------------------------------------------------
         TEMAS Y NAVEGACIÓN (5 PESTAÑAS)
         ----------------------------------------------------------------------- */
      function applyTheme(theme) {
        const valid = ['lowlight', 'beige', 'magenta'].includes(theme) ? theme : 'lowlight';
        state.theme = valid;
        document.documentElement.setAttribute('data-theme', valid);
        document.getElementById('themeSelect').value = valid;
        const themeColors = { lowlight: '#12101a', beige: '#f5f0e8', magenta: '#1c101b' };
        const meta = document.getElementById('metaThemeColor');
        if (meta) meta.setAttribute('content', themeColors[valid] || '#12101a');
        saveState();
        if (activeTab === 'graficas') renderChartsTab();
      }

      function switchTab(tab) {
        activeTab = tab;
        ['rutina', 'cardio', 'graficas', 'catalogo', 'respaldo'].forEach(t => {
          document.getElementById(`tab-${t}`).classList.toggle('hidden', t !== tab);
        });
        document.querySelectorAll('.nav-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.tab === tab);
        });

        if (tab === 'rutina') renderTrainTab();
        if (tab === 'cardio') renderCardioTab();
        if (tab === 'graficas') renderChartsTab();
        if (tab === 'catalogo') renderCatalogTab();
        if (tab === 'respaldo') renderBackupTab();

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      /* -----------------------------------------------------------------------
         HELPERS DE EJERCICIOS
         ----------------------------------------------------------------------- */
      function getExercisesForRoutine(routineName) {
        return state.catalog.filter(ex => ex.routine === routineName);
      }

      function getLastLog(exId, exName) {
        const logs = state.strengthLogs.filter(l => l.exerciseId === exId || l.exerciseName === exName);
        if (!logs.length) return null;
        logs.sort((a, b) => (b.date !== a.date ? b.date.localeCompare(a.date) : (b.createdAt || 0) - (a.createdAt || 0)));
        return logs[0];
      }

      function isDoneToday(exId) {
        const arr = state.completedByDate[getTodayISO()] || [];
        return arr.includes(exId);
      }

      function toggleDoneToday(exId, forceState) {
        const today = getTodayISO();
        if (!Array.isArray(state.completedByDate[today])) state.completedByDate[today] = [];
        const list = state.completedByDate[today];
        const exists = list.includes(exId);
        const nextVal = typeof forceState === 'boolean' ? forceState : !exists;
        if (nextVal && !exists) list.push(exId);
        if (!nextVal && exists) state.completedByDate[today] = list.filter(id => id !== exId);
        saveState();
      }

      /* -----------------------------------------------------------------------
         PESTAÑA 1: RUTINA
         ----------------------------------------------------------------------- */
      function renderTrainTab() {
        const exercises = getExercisesForRoutine(activeRoutine);
        if (!exercises.some(e => e.id === selectedExerciseId)) {
          selectedExerciseId = exercises.length ? exercises[0].id : null;
        }

        const doneCount = exercises.filter(e => isDoneToday(e.id)).length;
        const pct = exercises.length ? Math.round((doneCount / exercises.length) * 100) : 0;
        document.getElementById('routineProgressBadge').textContent = `${doneCount} / ${exercises.length} hechos`;
        document.getElementById('routineProgressBar').style.width = `${pct}%`;

        const listEl = document.getElementById('exerciseChecklist');
        if (!exercises.length) {
          listEl.innerHTML = '<p class="text-muted">No hay ejercicios en esta rutina.</p>';
        } else {
          listEl.innerHTML = exercises.map(ex => {
            const done = isDoneToday(ex.id);
            const selected = ex.id === selectedExerciseId;
            const last = getLastLog(ex.id, ex.name);
            const wTxt = last
              ? `${formatDualWeight(last.weightLb, last.weightKg)} · ${last.sets}×${last.reps}${ex.isAssisted ? ' (asist.)' : ''}`
              : `Meta: ${ex.targetSets}×${ex.targetReps}`;

            return `
              <div class="ex-item ${selected ? 'selected' : ''} ${done ? 'done' : ''}" data-select-ex="${esc(ex.id)}">
                <button type="button" class="check-circle" data-toggle-ex="${esc(ex.id)}" aria-label="Marcar ${esc(ex.name)}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                </button>
                <div class="machine-svg-box" aria-hidden="true">${getIconSvg(ex.icon)}</div>
                <div class="ex-meta">
                  <div class="ex-name">${esc(ex.name)}</div>
                  <div class="ex-everyday">${esc(ex.everyday)}</div>
                  <div class="ex-weight-line">${esc(wTxt)}</div>
                </div>
              </div>
            `;
          }).join('');

          listEl.querySelectorAll('[data-select-ex]').forEach(row => {
            row.addEventListener('click', (e) => {
              if (e.target.closest('[data-toggle-ex]')) return;
              selectedExerciseId = row.dataset.selectEx;
              renderTrainTab();
              fillFormDefaultsForSelected(false);
            });
          });

          listEl.querySelectorAll('[data-toggle-ex]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleDoneToday(btn.dataset.toggleEx);
              renderTrainTab();
            });
          });
        }

        renderActiveExercisePanel();
      }

      function renderActiveExercisePanel() {
        const ex = state.catalog.find(c => c.id === selectedExerciseId);
        if (!ex) return;

        document.getElementById('activeIconBox').innerHTML = getIconSvg(ex.icon);
        document.getElementById('activeExerciseTitle').textContent = ex.name;
        document.getElementById('activeEverydayBadge').textContent = ex.everyday || 'Ejercicio en máquina';
        document.getElementById('activeExerciseMeta').textContent = `Meta: ${ex.targetSets}×${ex.targetReps}`;
        document.getElementById('assistedBanner').classList.toggle('hidden', !ex.isAssisted);

        const lv = ex.levers || { seat: '', back: '', mid: '' };
        document.getElementById('leverSeat').value = lv.seat || '';
        document.getElementById('leverBack').value = lv.back || '';
        document.getElementById('leverMid').value = lv.mid || '';
        document.getElementById('leverSavedBadge').textContent = 'Se guarda solo';

        const memContent = document.getElementById('memoryContent');
        const btnUse = document.getElementById('btnUseLastData');
        const last = getLastLog(ex.id, ex.name);

        if (!last) {
          btnUse.classList.add('hidden');
          memContent.innerHTML = `<p class="text-sub">Sin registros previos para <strong>${esc(ex.name)}</strong>.</p>`;
          return;
        }

        btnUse.classList.remove('hidden');
        const dualTxt = formatDualWeight(last.weightLb, last.weightKg);

        memContent.innerHTML = `
          <div class="row-between" style="margin-bottom: 8px; flex-wrap: wrap;">
            <strong style="font-size: 0.9rem;">${ex.isAssisted ? 'Última asistencia' : 'Último peso registrado'}</strong>
            <span class="badge">${formatDateES(last.date)}</span>
          </div>
          <div class="grid-2" style="margin-bottom: 8px;">
            <div class="stat-box" style="padding: 8px;">
              <div class="text-muted" style="font-size: 0.69rem;">Peso (lb / kg)</div>
              <div style="font-size: 0.95rem; font-weight: 800; color: var(--accent); margin-top: 2px;">${esc(dualTxt)}</div>
            </div>
            <div class="stat-box" style="padding: 8px;">
              <div class="text-muted" style="font-size: 0.69rem;">Series × Reps</div>
              <div style="font-size: 0.95rem; font-weight: 800; margin-top: 2px;">${esc(last.sets)} × ${esc(last.reps)}</div>
            </div>
          </div>
          ${last.notes ? `<p class="text-sub" style="font-size: 0.8rem;">💡 ${esc(last.notes)}</p>` : ''}
        `;
      }

      function handleLeverAutoSave() {
        const ex = state.catalog.find(c => c.id === selectedExerciseId);
        if (!ex) return;
        ex.levers = {
          seat: document.getElementById('leverSeat').value.trim(),
          back: document.getElementById('leverBack').value.trim(),
          mid: document.getElementById('leverMid').value.trim()
        };
        saveState();
        const badge = document.getElementById('leverSavedBadge');
        badge.textContent = '✓ Guardado';
        badge.style.color = 'var(--success)';
        setTimeout(() => {
          badge.textContent = 'Se guarda solo';
          badge.style.color = '';
        }, 1200);
      }

      function syncFromLb() {
        const lbVal = parseFloat(document.getElementById('inpWeightLb').value);
        if (!isNaN(lbVal) && lbVal >= 0) {
          document.getElementById('inpWeightKg').value = lbToKg(lbVal);
        }
      }

      function syncFromKg() {
        const kgVal = parseFloat(document.getElementById('inpWeightKg').value);
        if (!isNaN(kgVal) && kgVal >= 0) {
          document.getElementById('inpWeightLb').value = kgToLb(kgVal);
        }
      }

      function fillFormDefaultsForSelected(fromButtonClick) {
        const ex = state.catalog.find(c => c.id === selectedExerciseId);
        if (!ex) return;
        const last = getLastLog(ex.id, ex.name);

        if (last) {
          document.getElementById('inpWeightLb').value = round1(last.weightLb);
          document.getElementById('inpWeightKg').value = round1(last.weightKg);
          document.getElementById('inpSets').value = last.sets;
          document.getElementById('inpReps').value = last.reps;
          document.getElementById('inpNotes').value = fromButtonClick ? (last.notes || '') : '';
          if (fromButtonClick) {
            showToast(ex.isAssisted
              ? 'Última asistencia cargada. ¡Intenta bajar el peso si puedes!'
              : `Cargado: ${formatDualWeight(last.weightLb, last.weightKg)}`);
          }
        } else {
          document.getElementById('inpWeightLb').value = 0;
          document.getElementById('inpWeightKg').value = 0;
          document.getElementById('inpSets').value = ex.targetSets || 3;
          document.getElementById('inpReps').value = ex.targetReps || '10';
          document.getElementById('inpNotes').value = '';
        }
        document.getElementById('inpDate').value = getTodayISO();
      }

      function handleStepper(stepType, dir) {
        if (stepType === 'lb') {
          const inp = document.getElementById('inpWeightLb');
          const curr = parseFloat(inp.value) || 0;
          inp.value = Math.max(0, round1(curr + dir * 5));
          syncFromLb();
        } else if (stepType === 'kg') {
          const inp = document.getElementById('inpWeightKg');
          const curr = parseFloat(inp.value) || 0;
          inp.value = Math.max(0, round1(curr + dir * 1));
          syncFromKg();
        } else if (stepType === 'sets') {
          const inp = document.getElementById('inpSets');
          const curr = parseInt(inp.value, 10) || 1;
          inp.value = Math.max(1, Math.min(30, curr + dir));
        } else if (stepType === 'reps') {
          const inp = document.getElementById('inpReps');
          const raw = inp.value.trim();
          const match = raw.match(/^(\d+)(.*)$/);
          if (match) {
            const num = parseInt(match[1], 10);
            const suffix = match[2] || '';
            const step = suffix.toLowerCase().includes('s') ? 5 : 1;
            inp.value = `${Math.max(1, num + dir * step)}${suffix}`;
          } else {
            inp.value = '10';
          }
        }
      }

      function handleStrengthSubmit(e) {
        e.preventDefault();
        const ex = state.catalog.find(c => c.id === selectedExerciseId);
        if (!ex) return;

        const weightLb = round1(document.getElementById('inpWeightLb').value);
        const weightKg = round1(document.getElementById('inpWeightKg').value);
        const sets = parseInt(document.getElementById('inpSets').value, 10);
        const reps = document.getElementById('inpReps').value.trim();
        const date = document.getElementById('inpDate').value || getTodayISO();
        const notes = document.getElementById('inpNotes').value.trim();

        if (isNaN(weightLb) || weightLb < 0 || isNaN(sets) || sets < 1 || !reps) {
          showToast('Revisa los datos ingresados.', 'danger');
          return;
        }

        state.strengthLogs.unshift({
          id: uid('str'),
          exerciseId: ex.id,
          exerciseName: ex.name,
          weightLb,
          weightKg,
          sets,
          reps,
          notes,
          isAssisted: !!ex.isAssisted,
          date,
          createdAt: Date.now()
        });

        if (date === getTodayISO()) toggleDoneToday(ex.id, true);
        saveState();
        document.getElementById('inpNotes').value = '';
        renderTrainTab();
        showToast(`Guardado: ${ex.name} (${formatDualWeight(weightLb, weightKg)})`);
      }

      /* -----------------------------------------------------------------------
         PESTAÑA 2: CARDIO / 5K
         ----------------------------------------------------------------------- */
      function toggleCardioFields() {
        const mod = document.getElementById('cardioModality').value;
        document.getElementById('stairsFields').classList.toggle('hidden', mod !== 'Escalera');
        document.getElementById('runWalkFields').classList.toggle('hidden', mod !== 'Run-Walk (Trote + Caminata)');
      }

      function renderCardioTab() {
        toggleCardioFields();

        const bestKm = state.cardioLogs.reduce((max, c) => Math.max(max, parseFloat(c.distance) || 0), 0);
        document.getElementById('bestDistanceLabel').textContent = `${bestKm.toFixed(2)} km`;

        const p5 = Math.min(100, Math.round((bestKm / 5) * 100));
        const p10 = Math.min(100, Math.round((bestKm / 10) * 100));
        document.getElementById('bar5k').style.width = `${p5}%`;
        document.getElementById('label5k').textContent = p5 >= 100 ? '¡5K Logrado! 🎉' : `${p5}% (${bestKm.toFixed(1)} / 5 km)`;
        document.getElementById('bar10k').style.width = `${p10}%`;
        document.getElementById('label10k').textContent = p10 >= 100 ? '¡10K Logrado! 🏆' : `${p10}% (${bestKm.toFixed(1)} / 10 km)`;

        const list = document.getElementById('cardioList');
        const sorted = [...state.cardioLogs].sort((a, b) => (b.date !== a.date ? b.date.localeCompare(a.date) : (b.createdAt || 0) - (a.createdAt || 0)));

        if (!sorted.length) {
          list.innerHTML = '<p class="text-muted">Aún no hay sesiones de cardio. ¡Registra tus 15 min de escalera o tus intervalos Run-Walk!</p>';
          return;
        }

        list.innerHTML = sorted.map(c => {
          const extra = [];
          if (c.stairsLevel) extra.push(`Nivel: ${c.stairsLevel}`);
          if (c.stairsFloors) extra.push(c.stairsFloors);
          if (c.runMin || c.walkMin) extra.push(`🏃‍♀️ ${c.runMin || 0}m trote / 🚶‍♀️ ${c.walkMin || 0}m caminata`);
          return `
            <div class="subcard row-between" style="align-items: flex-start;">
              <div style="min-width: 0;">
                <div class="row-wrap" style="margin-bottom: 4px;">
                  <strong style="font-size: 0.9rem;">${esc(c.modality)}</strong>
                  <span class="badge">${formatDateES(c.date)}</span>
                </div>
                <p class="text-sub" style="font-size: 0.82rem;">
                  <strong class="text-accent">${esc(c.duration)} min</strong>
                  ${c.distance > 0 ? ` · <strong>${parseFloat(c.distance).toFixed(2)} km</strong>` : ''}
                  ${extra.length ? ` · ${esc(extra.join(' · '))}` : ''}
                </p>
                ${c.notes ? `<p class="text-muted" style="margin-top: 3px;">${esc(c.notes)}</p>` : ''}
              </div>
              <button type="button" class="btn btn-icon btn-sm" data-del-cardio="${esc(c.id)}" aria-label="Eliminar">🗑</button>
            </div>
          `;
        }).join('');

        list.querySelectorAll('[data-del-cardio]').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.dataset.delCardio;
            openConfirm('Eliminar cardio', '¿Borrar esta sesión de cardio?', () => {
              state.cardioLogs = state.cardioLogs.filter(c => c.id !== id);
              saveState();
              renderCardioTab();
              showToast('Sesión eliminada.');
            }, 'Eliminar');
          });
        });
      }

      function handleCardioSubmit(e) {
        e.preventDefault();
        const modality = document.getElementById('cardioModality').value;
        const date = document.getElementById('cardioDate').value || getTodayISO();
        const duration = parseInt(document.getElementById('cardioDuration').value, 10);
        const distance = parseFloat(document.getElementById('cardioDistance').value) || 0;
        const stairsLevel = modality === 'Escalera' ? document.getElementById('stairsLevel').value.trim() : '';
        const stairsFloors = modality === 'Escalera' ? document.getElementById('stairsFloors').value.trim() : '';
        const runMin = modality === 'Run-Walk (Trote + Caminata)' ? (parseFloat(document.getElementById('rwRunMin').value) || 0) : 0;
        const walkMin = modality === 'Run-Walk (Trote + Caminata)' ? (parseFloat(document.getElementById('rwWalkMin').value) || 0) : 0;
        const notes = document.getElementById('cardioNotes').value.trim();

        if (isNaN(duration) || duration <= 0) {
          showToast('Ingresa una duración válida.', 'danger');
          return;
        }

        state.cardioLogs.unshift({
          id: uid('car'),
          modality,
          date,
          duration,
          distance,
          stairsLevel,
          stairsFloors,
          runMin,
          walkMin,
          notes,
          createdAt: Date.now()
        });
        saveState();
        document.getElementById('cardioDistance').value = '';
        document.getElementById('cardioNotes').value = '';
        renderCardioTab();
        showToast(`Cardio guardado: ${modality} (${duration} min)`);
      }

      /* -----------------------------------------------------------------------
         PESTAÑA 3: GRÁFICAS + DESCARGA PNG + RESUMEN WHATSAPP
         ----------------------------------------------------------------------- */
      function renderChartsTab() {
        const unit = state.chartUnit === 'kg' ? 'kg' : 'lb';
        document.getElementById('btnChartLb').classList.toggle('active', unit === 'lb');
        document.getElementById('btnChartKg').classList.toggle('active', unit === 'kg');

        const select = document.getElementById('chartExerciseSelect');
        const prev = select.value;

        const map = new Map();
        state.catalog.forEach(c => map.set(c.id, { id: c.id, name: c.name, everyday: c.everyday, isAssisted: c.isAssisted }));
        state.strengthLogs.forEach(l => {
          if (!map.has(l.exerciseId)) {
            map.set(l.exerciseId, { id: l.exerciseId, name: l.exerciseName, everyday: '', isAssisted: !!l.isAssisted });
          }
        });

        select.innerHTML = '';
        map.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.id;
          opt.textContent = item.everyday ? `${item.name} — ${item.everyday}` : item.name;
          select.appendChild(opt);
        });

        if (prev && map.has(prev)) select.value = prev;
        else if (selectedExerciseId && map.has(selectedExerciseId)) select.value = selectedExerciseId;

        const chosen = map.get(select.value);
        document.getElementById('statTotalLogs').textContent = state.strengthLogs.length + state.cardioLogs.length;
        if (!chosen) return;

        const logs = state.strengthLogs
          .filter(l => l.exerciseId === chosen.id || l.exerciseName === chosen.name)
          .sort((a, b) => (a.date !== b.date ? a.date.localeCompare(b.date) : (a.createdAt || 0) - (b.createdAt || 0)));

        document.getElementById('statExerciseCount').textContent = logs.length;
        document.getElementById('chartSubtitle').textContent = chosen.isAssisted
          ? `Asistencia en ${unit} (bajar = ¡más fuerza!)`
          : `Evolución real unificada en ${unit}`;

        const chartWrap = document.getElementById('svgChartContainer');
        if (!logs.length) {
          lastRenderedChartMeta = null;
          document.getElementById('statBestMark').textContent = '—';
          document.getElementById('statBestSub').textContent = 'Sin datos';
          chartWrap.innerHTML = '<p class="text-muted" style="text-align:center;padding:34px 12px;">Sin registros para graficar.</p>';
        } else {
          const getVal = l => unit === 'kg'
            ? (l.weightKg != null ? round1(l.weightKg) : lbToKg(l.weightLb))
            : (l.weightLb != null ? round1(l.weightLb) : kgToLb(l.weightKg));

          const vals = logs.map(getVal);
          const best = chosen.isAssisted ? Math.min(...vals) : Math.max(...vals);
          const bestOther = unit === 'kg' ? `${kgToLb(best)} lb` : `${lbToKg(best)} kg`;
          document.getElementById('statBestMark').textContent = `${best} ${unit}`;
          document.getElementById('statBestSub').textContent = `≈ ${bestOther}`;

          const byDate = {};
          logs.forEach(l => {
            const v = getVal(l);
            if (byDate[l.date] === undefined) byDate[l.date] = v;
            else byDate[l.date] = chosen.isAssisted ? Math.min(byDate[l.date], v) : Math.max(byDate[l.date], v);
          });

          const points = Object.keys(byDate).sort().map(d => ({ date: d, val: byDate[d] }));
          const lastLog = logs[logs.length - 1];
          lastRenderedChartMeta = {
            chosen,
            unit,
            points,
            best,
            bestOther,
            lastLog,
            logsCount: logs.length
          };
          chartWrap.innerHTML = buildSVGLineChart(points, unit);
        }

        const histEl = document.getElementById('exerciseHistoryList');
        const descLogs = [...logs].reverse();
        if (!descLogs.length) {
          histEl.innerHTML = '<p class="text-muted">Aún no hay registros.</p>';
        } else {
          histEl.innerHTML = descLogs.map(l => `
            <div class="subcard row-between" style="align-items: flex-start;">
              <div>
                <div class="row-wrap" style="margin-bottom: 3px;">
                  <strong class="text-accent">${esc(formatDualWeight(l.weightLb, l.weightKg))}</strong>
                  <span style="font-size: 0.84rem; font-weight: 700;">· ${esc(l.sets)}×${esc(l.reps)}</span>
                  <span class="badge">${formatDateES(l.date)}</span>
                </div>
                ${l.notes ? `<p class="text-muted">${esc(l.notes)}</p>` : ''}
