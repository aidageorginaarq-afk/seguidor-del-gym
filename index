              <button type="button" class="btn btn-icon btn-sm" data-del-str="${esc(l.id)}" aria-label="Eliminar">🗑</button>
            </div>
          `).join('');

          histEl.querySelectorAll('[data-del-str]').forEach(btn => {
            btn.addEventListener('click', () => {
              const id = btn.dataset.delStr;
              openConfirm('Eliminar registro', '¿Borrar este registro del historial?', () => {
                state.strengthLogs = state.strengthLogs.filter(x => x.id !== id);
                saveState();
                renderChartsTab();
                showToast('Registro eliminado.');
              }, 'Eliminar');
            });
          });
        }
      }

      function buildSVGLineChart(points, unit) {
        const W = 560, H = 220, padL = 48, padR = 26, padT = 26, padB = 34;
        const plotW = W - padL - padR;
        const plotH = H - padT - padB;

        const vals = points.map(p => p.val);
        let minV = Math.min(...vals);
        let maxV = Math.max(...vals);
        if (minV === maxV) {
          minV = Math.max(0, minV - 5);
          maxV = maxV + 5;
        } else {
          const margin = (maxV - minV) * 0.2;
          minV = Math.max(0, Math.floor(minV - margin));
          maxV = Math.ceil(maxV + margin);
        }

        const coords = points.map((p, i) => ({
          x: points.length === 1 ? padL + plotW / 2 : padL + (i / (points.length - 1)) * plotW,
          y: padT + plotH - ((p.val - minV) / (maxV - minV)) * plotH,
          ...p
        }));

        const st = getComputedStyle(document.documentElement);
        const accent = st.getPropertyValue('--accent').trim() || '#b794f6';
        const textMuted = st.getPropertyValue('--text-muted').trim() || '#888';
        const border = st.getPropertyValue('--border').trim() || '#333';
        const textMain = st.getPropertyValue('--text-main').trim() || '#fff';
        const bgInput = st.getPropertyValue('--bg-input').trim() || '#111';

        let grid = '';
        for (let i = 0; i <= 3; i++) {
          const f = i / 3;
          const y = padT + plotH * (1 - f);
          const vLab = round1(minV + (maxV - minV) * f);
          grid += `
            <line x1="${padL}" y1="${y.toFixed(1)}" x2="${W - padR}" y2="${y.toFixed(1)}" stroke="${border}" stroke-dasharray="3 4" stroke-width="1"/>
            <text x="${padL - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" fill="${textMuted}" font-size="11">${vLab}</text>
          `;
        }

        const poly = coords.map(c => `${c.x.toFixed(1)},${c.y.toFixed(1)}`).join(' ');
        const area = coords.length > 1
          ? `M ${coords[0].x.toFixed(1)},${(padT + plotH).toFixed(1)} L ${coords.map(c => `${c.x.toFixed(1)},${c.y.toFixed(1)}`).join(' L ')} L ${coords[coords.length - 1].x.toFixed(1)},${(padT + plotH).toFixed(1)} Z`
          : '';

        const dots = coords.map((c, idx) => {
          const show = coords.length <= 7 || idx === 0 || idx === coords.length - 1 || idx % Math.ceil(coords.length / 5) === 0;
          return `
            <circle cx="${c.x.toFixed(1)}" cy="${c.y.toFixed(1)}" r="5" fill="${accent}" stroke="${bgInput}" stroke-width="2"/>
            ${show ? `<text x="${c.x.toFixed(1)}" y="${(c.y - 10).toFixed(1)}" text-anchor="middle" fill="${textMain}" font-size="11" font-weight="700">${c.val} ${unit}</text>` : ''}
            ${show ? `<text x="${c.x.toFixed(1)}" y="${H - 10}" text-anchor="middle" fill="${textMuted}" font-size="10">${esc(formatDateShort(c.date))}</text>` : ''}
          `;
        }).join('');

        return `
          <svg viewBox="0 0 ${W} ${H}" width="100%" height="auto" role="img" aria-label="Gráfica de evolución">
            <defs>
              <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="${accent}" stop-opacity="0.32"/>
                <stop offset="100%" stop-color="${accent}" stop-opacity="0.02"/>
              </linearGradient>
            </defs>
            ${grid}
            ${area ? `<path d="${area}" fill="url(#chartGrad)"/>` : ''}
            ${coords.length > 1 ? `<polyline fill="none" stroke="${accent}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="${poly}"/>` : ''}
            ${dots}
          </svg>
        `;
      }

      /* -----------------------------------------------------------------------
         DESCARGAR GRÁFICA EN PNG DE ALTA RESOLUCIÓN (LISTA PARA WHATSAPP)
         ----------------------------------------------------------------------- */
      function downloadChartPng() {
        if (!lastRenderedChartMeta || !lastRenderedChartMeta.points.length) {
          showToast('No hay datos para descargar en este ejercicio.', 'danger');
          return;
        }
        try {
          const { chosen, unit, points, best, bestOther, lastLog } = lastRenderedChartMeta;
          const st = getComputedStyle(document.documentElement);
          const bgApp = st.getPropertyValue('--bg-app').trim() || '#12101a';
          const bgSurf = st.getPropertyValue('--bg-surface').trim() || '#1b1826';
          const border = st.getPropertyValue('--border').trim() || '#322c46';
          const textMain = st.getPropertyValue('--text-main').trim() || '#f4f2fa';
          const textSub = st.getPropertyValue('--text-sub').trim() || '#b3acc9';
          const textMuted = st.getPropertyValue('--text-muted').trim() || '#7c7496';
          const accent = st.getPropertyValue('--accent').trim() || '#b794f6';
          const accent2 = st.getPropertyValue('--accent-2').trim() || '#e879f9';

          const W = 1080;
          const H = 740;
          const canvas = document.createElement('canvas');
          canvas.width = W;
          canvas.height = H;
          const ctx = canvas.getContext('2d');

          // Fondo principal
          ctx.fillStyle = bgApp;
          ctx.fillRect(0, 0, W, H);

          // Tarjeta interior
          function rRect(x, y, w, h, r) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.arcTo(x + w, y, x + w, y + h, r);
            ctx.arcTo(x + w, y + h, x, y + h, r);
            ctx.arcTo(x, y + h, x, y, r);
            ctx.arcTo(x, y, x + w, y, r);
            ctx.closePath();
          }

          ctx.fillStyle = bgSurf;
          rRect(36, 36, W - 72, H - 72, 28);
          ctx.fill();
          ctx.strokeStyle = border;
          ctx.lineWidth = 2;
          ctx.stroke();

          // Encabezado
          ctx.fillStyle = accent;
          ctx.font = 'bold 22px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          ctx.fillText('GYM TRACKER · EVOLUCIÓN DE PROGRESO', 74, 92);

          ctx.fillStyle = textMain;
          ctx.font = '800 38px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          ctx.fillText(chosen.name.slice(0, 38), 74, 142);

          if (chosen.everyday) {
            ctx.fillStyle = textSub;
            ctx.font = '500 22px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
            ctx.fillText(chosen.everyday.slice(0, 58), 74, 178);
          }

          // Tarjeta de Récord arriba a la derecha
          const badgeW = 260, badgeH = 92, badgeX = W - 74 - badgeW, badgeY = 72;
          ctx.fillStyle = bgApp;
          rRect(badgeX, badgeY, badgeW, badgeH, 18);
          ctx.fill();
          ctx.strokeStyle = accent;
          ctx.lineWidth = 2;
          ctx.stroke();

          ctx.fillStyle = textMuted;
          ctx.font = 'bold 17px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          ctx.fillText(chosen.isAssisted ? 'MEJOR ASISTENCIA' : 'RÉCORD ACTUAL', badgeX + 20, badgeY + 30);
          ctx.fillStyle = accent;
          ctx.font = '800 30px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          ctx.fillText(`${best} ${unit}`, badgeX + 20, badgeY + 64);
          ctx.fillStyle = textSub;
          ctx.font = '600 16px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          ctx.fillText(`≈ ${bestOther}`, badgeX + 20, badgeY + 84);

          // Área de gráfica
          const padL = 128, padR = 96, padT = 235, padB = 135;
          const plotW = W - padL - padR;
          const plotH = H - padT - padB;

          const vals = points.map(p => p.val);
          let minV = Math.min(...vals);
          let maxV = Math.max(...vals);
          if (minV === maxV) {
            minV = Math.max(0, minV - 5);
            maxV = maxV + 5;
          } else {
            const margin = (maxV - minV) * 0.22;
            minV = Math.max(0, Math.floor(minV - margin));
            maxV = Math.ceil(maxV + margin);
          }

          // Rejilla horizontal
          ctx.strokeStyle = border;
          ctx.lineWidth = 1.5;
          ctx.setLineDash([6, 8]);
          ctx.font = '600 19px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          for (let i = 0; i <= 3; i++) {
            const f = i / 3;
            const y = padT + plotH * (1 - f);
            const vLab = round1(minV + (maxV - minV) * f);
            ctx.beginPath();
            ctx.moveTo(padL, y);
            ctx.lineTo(W - padR, y);
            ctx.stroke();

            ctx.fillStyle = textMuted;
            ctx.textAlign = 'right';
            ctx.fillText(`${vLab} ${unit}`, padL - 16, y + 6);
          }
          ctx.setLineDash([]);

          const coords = points.map((p, i) => ({
            x: points.length === 1 ? padL + plotW / 2 : padL + (i / (points.length - 1)) * plotW,
            y: padT + plotH - ((p.val - minV) / (maxV - minV)) * plotH,
            ...p
          }));

          // Relleno degradado bajo la curva
          if (coords.length > 1) {
            const areaGrad = ctx.createLinearGradient(0, padT, 0, padT + plotH);
            areaGrad.addColorStop(0, 'rgba(183, 148, 246, 0.34)');
            areaGrad.addColorStop(1, 'rgba(183, 148, 246, 0.02)');
            ctx.fillStyle = areaGrad;
            ctx.beginPath();
            ctx.moveTo(coords[0].x, padT + plotH);
            coords.forEach(c => ctx.lineTo(c.x, c.y));
            ctx.lineTo(coords[coords.length - 1].x, padT + plotH);
            ctx.closePath();
            ctx.fill();

            // Línea principal
            const lineGrad = ctx.createLinearGradient(padL, 0, W - padR, 0);
            lineGrad.addColorStop(0, accent);
            lineGrad.addColorStop(1, accent2);
            ctx.strokeStyle = lineGrad;
            ctx.lineWidth = 6;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.beginPath();
            coords.forEach((c, idx) => (idx === 0 ? ctx.moveTo(c.x, c.y) : ctx.lineTo(c.x, c.y)));
            ctx.stroke();
          }

          // Puntos y etiquetas
          ctx.textAlign = 'center';
          coords.forEach((c, idx) => {
            const show = coords.length <= 7 || idx === 0 || idx === coords.length - 1 || idx % Math.ceil(coords.length / 5) === 0;
            ctx.beginPath();
            ctx.arc(c.x, c.y, 9, 0, Math.PI * 2);
            ctx.fillStyle = accent;
            ctx.fill();
            ctx.lineWidth = 4;
            ctx.strokeStyle = bgSurf;
            ctx.stroke();

            if (show) {
              ctx.fillStyle = textMain;
              ctx.font = '800 20px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
              ctx.fillText(`${c.val} ${unit}`, c.x, c.y - 18);

              ctx.fillStyle = textMuted;
              ctx.font = '600 18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
              ctx.fillText(formatDateShort(c.date), c.x, padT + plotH + 34);
            }
          });

          // Pie de imagen con último registro y fecha
          ctx.textAlign = 'left';
          ctx.fillStyle = textSub;
          ctx.font = '600 20px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          const lastSummary = `Último registro: ${formatDualWeight(lastLog.weightLb, lastLog.weightKg)} · ${lastLog.sets}×${lastLog.reps} (${formatDateES(lastLog.date)})`;
          ctx.fillText(lastSummary, 74, H - 64);

          ctx.textAlign = 'right';
          ctx.fillStyle = textMuted;
          ctx.font = '600 18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
          ctx.fillText(`Generado el ${formatDateES(getTodayISO())}`, W - 74, H - 64);

          const slug = chosen.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
          const link = document.createElement('a');
          link.download = `grafica-${slug}-${getTodayISO()}.png`;
          link.href = canvas.toDataURL('image/png');
          document.body.appendChild(link);
          link.click();
          link.remove();
          showToast('📸 Gráfica PNG descargada, lista para WhatsApp.');
        } catch (err) {
          console.error('Error exportando PNG:', err);
          showToast('No se pudo generar la imagen PNG.', 'danger');
        }
      }

      /* -----------------------------------------------------------------------
         COPIAR RESUMEN PARA WHATSAPP (GYM BRO)
         ----------------------------------------------------------------------- */
      function copyWhatsAppChartSummary() {
        if (!lastRenderedChartMeta) {
          showToast('Selecciona un ejercicio con registros primero.', 'danger');
          return;
        }
        const { chosen, unit, best, bestOther, lastLog, points } = lastRenderedChartMeta;
        const firstVal = points[0].val;
        const lastVal = points[points.length - 1].val;
        const diff = round1(lastVal - firstVal);
        const diffStr = points.length > 1
          ? (diff === 0 ? 'Sin cambio aún' : `${diff > 0 ? '+' : ''}${diff} ${unit} desde ${formatDateShort(points[0].date)}`)
          : 'Primer registro base';

        const text = [
          `💪 *Avance Gym Tracker*`,
          `🏋️‍♀️ *${chosen.name}*${chosen.everyday ? ` (${chosen.everyday})` : ''}`,
          `📊 Última sesión (${formatDateES(lastLog.date)}): *${formatDualWeight(lastLog.weightLb, lastLog.weightKg)}* — ${lastLog.sets}×${lastLog.reps}`,
          `🏆 ${chosen.isAssisted ? 'Mejor asistencia' : 'Récord'}: *${best} ${unit}* (≈ ${bestOther})`,
          `📈 Progreso: ${diffStr}`
        ].join('\n');

        copyTextReliable(text, '💬 Resumen copiado, ¡listo para pegar en WhatsApp!');
      }

      function copyWhatsAppFullSessionSummary() {
        const sortedStr = [...state.strengthLogs].sort((a, b) => (b.date !== a.date ? b.date.localeCompare(a.date) : (b.createdAt || 0) - (a.createdAt || 0)));
        const lastDate = sortedStr.length ? sortedStr[0].date : getTodayISO();
        const sessionLogs = sortedStr.filter(l => l.date === lastDate);

        // Quedarse con el último registro por ejercicio de esa fecha
        const uniqueMap = new Map();
        sessionLogs.forEach(l => {
          if (!uniqueMap.has(l.exerciseName)) uniqueMap.set(l.exerciseName, l);
        });

        const lines = [`💪 *Resumen Gym Tracker* (${formatDateES(lastDate)})`];

        if (uniqueMap.size) {
          lines.push('');
          uniqueMap.forEach(l => {
            lines.push(`• *${l.exerciseName}*: ${formatDualWeight(l.weightLb, l.weightKg)} — ${l.sets}×${l.reps}`);
          });
        } else {
          lines.push('Sin registros de fuerza aún.');
        }

        const sortedCardio = [...state.cardioLogs].sort((a, b) => b.date.localeCompare(a.date));
        if (sortedCardio.length) {
          const c = sortedCardio[0];
          lines.push('');
          lines.push(`🏃‍♀️ *Último cardio* (${formatDateES(c.date)}): ${c.modality} — ${c.duration} min${c.distance > 0 ? ` (${c.distance} km)` : ''}`);
        }

        copyTextReliable(lines.join('\n'), '💬 Resumen de sesión copiado para WhatsApp.');
      }

